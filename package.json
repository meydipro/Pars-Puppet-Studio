{
  "name": "pars-puppet-studio",
  "version": "1.0.0",
  "description": "Browser-based 2D Delaunay mesh puppet animation, custom Pen mouth lip-sync, and transparent GIF89a studio.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "puppet-animation",
    "2d-mesh-deformation",
    "delaunay",
    "geodesic-skinning",
    "lip-sync",
    "webgl",
    "gif-exporter",
    "react",
    "typescript"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.1.0",
    "delaunator": "^5.0.1",
    "gifenc": "^1.0.3",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/delaunator": "^5.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
